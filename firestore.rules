rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Projects & Tasks (Consolidated Rules)
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.editorId == request.auth.uid || 
        resource.data.assignedEditorId == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid || isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid || 
        resource.data.editorId == request.auth.uid ||
        resource.data.assignedEditorId == request.auth.uid
      );
      
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.editorId == request.auth.uid || 
        resource.data.assignedEditorId == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid || isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid || 
        resource.data.editorId == request.auth.uid ||
        resource.data.assignedEditorId == request.auth.uid
      );
      
      allow delete: if isAdmin();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Conversations & Global Messaging
    match /conversations/{convId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && request.auth.uid in resource.data.participants) || 
        (resource == null && request.auth.uid in request.resource.data.participants) ||
        convId == 'admin_' + request.auth.uid ||
        isAdmin()
      );
      
      match /messages/{msgId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([request.auth.uid]) ||
          convId == 'admin_' + request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Announcements (Notification Center)
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Payment Chat (Queries)
    match /paymentQueries/{chatId} {
      allow read, write: if isAuthenticated() && (chatId == 'payment_admin_' + request.auth.uid || isAdmin());
      
      match /messages/{msgId} {
        allow read, write: if isAuthenticated() && (chatId == 'payment_admin_' + request.auth.uid || isAdmin());
      }
    }

    // Leads & Marketing CRM
    match /leads/{leadId} {
      allow read, write: if isAdmin() || 
        (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'marketing');
    }

    // Content Planner (Marketing)
    match /contentPosts/{postId} {
      allow read, write: if isAdmin() ||
        (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'marketing');
    }

    // Competitor Intel (Marketing)
    match /competitors/{compId} {
      allow read, write: if isAdmin() ||
        (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'marketing');
    }
  }
}
